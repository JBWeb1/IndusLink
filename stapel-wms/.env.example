# Copy to .env and fill in.
DATABASE_URL=postgres://stapel:stapel@localhost:5432/stapel
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
PORT=3000
NODE_ENV=development
# Set to 1 when your host requires SSL to Postgres (Render, Railway, Supabase, Neon)
PGSSL=0
